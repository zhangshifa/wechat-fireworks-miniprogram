<view class="container">
  <canvas type="2d" id="fw" class="fw-canvas" bindtap="onTapCanvas"></canvas>

  <!-- 控制按钮：暂停 / 音效 / 设置 -->
  <view class="controls" wx:if="{{!hideControls}}">
    <view class="btn" bindtap="onTogglePause">
      <text class="ico">{{paused ? '▶' : '❚❚'}}</text>
    </view>
    <view class="btn" bindtap="onToggleSound">
      <text class="ico">{{soundOn ? '🔊' : '🔇'}}</text>
    </view>
    <view class="btn" bindtap="onTogglePanel">
      <text class="ico">⚙</text>
    </view>
  </view>

  <!-- 设置面板 -->
  <view class="menu {{showPanel ? '' : 'hide'}}" catchtap="onClosePanel">
    <view class="menu__inner" catchtap="noop">
      <view class="close" bindtap="onClosePanel">✕</view>
      <view class="menu__header">设置</view>
      <view class="menu__subheader">若想了解更多信息 请点击任意标签</view>

      <scroll-view scroll-y class="menu__form">
        <view class="form-option">
          <text class="label">烟花类型</text>
          <picker class="picker" range="{{shellOptions}}" value="{{shellIndex}}" bindchange="onShellChange">
            <view class="picker-text">{{shellOptions[shellIndex]}}</view>
          </picker>
        </view>
        <view class="form-option">
          <text class="label">烟花大小</text>
          <picker class="picker" range="{{sizeOptions}}" value="{{sizeIndex}}" bindchange="onSizeChange">
            <view class="picker-text">{{sizeOptions[sizeIndex]}}</view>
          </picker>
        </view>
        <view class="form-option">
          <text class="label">画质</text>
          <picker class="picker" range="{{qualityOptions}}" value="{{qualityIndex}}" bindchange="onQualityChange">
            <view class="picker-text">{{qualityOptions[qualityIndex]}}</view>
          </picker>
        </view>
        <view class="form-option">
          <text class="label">照亮天空</text>
          <picker class="picker" range="{{skyOptions}}" value="{{skyIndex}}" bindchange="onSkyChange">
            <view class="picker-text">{{skyOptions[skyIndex]}}</view>
          </picker>
        </view>
        <view class="form-option">
          <text class="label">缩放</text>
          <picker class="picker" range="{{scaleOptions}}" value="{{scaleIndex}}" bindchange="onScaleChange">
            <view class="picker-text">{{scaleOptions[scaleIndex]}}</view>
          </picker>
        </view>

        <view class="form-option">
          <text class="label">自动放烟花</text>
          <switch checked="{{autoLaunch}}" bindchange="onAutoLaunch" color="#ffbf36" />
        </view>
        <view class="form-option">
          <text class="label">同时放更多的烟花</text>
          <switch checked="{{finale}}" bindchange="onFinale" color="#ffbf36" />
        </view>
        <view class="form-option">
          <text class="label">隐藏控制按钮</text>
          <switch checked="{{hideControls}}" bindchange="onHideControls" color="#ffbf36" />
        </view>
        <view class="form-option">
          <text class="label">全屏</text>
          <switch checked="{{fullscreen}}" bindchange="onFullscreen" color="#ffbf36" />
        </view>
        <view class="form-option">
          <text class="label">保留烟花的火花</text>
          <switch checked="{{longExposure}}" bindchange="onLongExposure" color="#ffbf36" />
        </view>
      </scroll-view>

      <view class="credits">烟花模拟器 · 致敬 NianBroken/Firework_Simulator</view>
    </view>
  </view>
</view>
