.container {
  width: 100%;
  height: 100%;
  /* 兜底：即使根节点高度异常，容器仍占满视口，保证 canvas 有真实尺寸 */
  min-height: 100vh;
  background: #000;
  overflow: hidden;
}

.fw-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 控制按钮：暂停 / 音效 / 设置 */
.controls {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  z-index: 10;
}

.btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.55;
  transition: opacity 0.3s;
}
.btn:active { opacity: 0.9; }
.ico {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  text-shadow: 0 0 8rpx rgba(255,255,255,0.3);
}

/* 设置面板 */
.menu {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.42);
  z-index: 20;
  transition: opacity 0.3s, visibility 0.3s;
}
.menu.hide {
  opacity: 0;
  visibility: hidden;
}
.menu__inner {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.close {
  position: absolute;
  top: 24rpx; right: 32rpx;
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.5);
  font-size: 40rpx;
}
.menu__header {
  font-size: 52rpx;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-top: auto;
}
.menu__subheader {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: auto;
  padding-bottom: 12rpx;
}
.menu__form {
  width: 100%;
  max-width: 640rpx;
  max-height: 64vh;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.form-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}
.form-option .label {
  width: 50%;
  text-align: right;
  padding-right: 24rpx;
  box-sizing: border-box;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.form-option .picker {
  width: 50%;
}
.picker-text {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 8rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.credits {
  margin-top: auto;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  text-align: center;
}
