.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #03040a;
  overflow: hidden;
}

.fw {
  width: 100%;
  height: 100%;
}

/* 顶部标题栏 */
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding-top: env(safe-area-inset-top);
  text-align: center;
  pointer-events: none;
}

.title {
  display: inline-block;
  margin-top: 28rpx;
  color: rgba(255, 243, 205, 0.92);
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 0 0 18rpx rgba(255, 200, 110, 0.7);
}

.gear {
  position: absolute;
  right: 28rpx;
  top: calc(env(safe-area-inset-top) + 24rpx);
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  pointer-events: auto;
  z-index: 20;
}

.gear:active {
  background: rgba(255, 255, 255, 0.22);
}

/* 控制面板 */
.panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 30;
}

.panel-inner {
  margin-top: calc(env(safe-area-inset-top) + 120rpx);
  width: 86%;
  background: rgba(20, 22, 36, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 28rpx 30rpx 34rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.5);
}

.panel-title {
  color: rgba(255, 243, 205, 0.95);
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 18rpx;
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  margin: 18rpx 0;
}

.row-label {
  width: 180rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  flex-shrink: 0;
}

.sl {
  flex: 1;
  margin: 0 6rpx;
}

/* 轨迹分段选择 */
.seg {
  flex: 1;
  display: flex;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 4rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 12rpx 0;
  border-radius: 12rpx;
}

.seg-item.on {
  background: rgba(255, 200, 110, 0.9);
  color: #1a1205;
  font-weight: bold;
}

.panel-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

/* 文字烟花条 */
.textbar {
  position: absolute;
  left: 28rpx;
  right: 120rpx;
  bottom: 110rpx;
  display: flex;
  align-items: center;
  z-index: 15;
}

.tinput {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 36rpx;
  padding: 0 28rpx;
  color: #fff;
  font-size: 28rpx;
}

.tinput-placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.tbtn {
  margin-left: 16rpx;
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 36rpx;
  background: linear-gradient(90deg, rgba(255, 158, 0, 0.95), rgba(247, 37, 133, 0.95));
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(247, 37, 133, 0.4);
}

.tbtn:active {
  opacity: 0.85;
}

/* 静音开关 */
.mute {
  position: absolute;
  right: 28rpx;
  bottom: 110rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  z-index: 15;
}

.mute:active {
  background: rgba(255, 255, 255, 0.22);
}

.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 48rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  pointer-events: none;
}
