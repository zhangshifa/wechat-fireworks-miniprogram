.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #03040a;
  overflow: hidden;
}

.fw {
  width: 100%;
  height: 100%;
}

/* 顶部标题栏 */
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding-top: env(safe-area-inset-top);
  text-align: center;
  pointer-events: none;
}

.title {
  display: inline-block;
  margin-top: 28rpx;
  color: rgba(255, 243, 205, 0.92);
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 0 0 18rpx rgba(255, 200, 110, 0.7);
}

/* 静音开关 */
.mute {
  position: absolute;
  right: 28rpx;
  bottom: 120rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  z-index: 10;
}

.mute:active {
  background: rgba(255, 255, 255, 0.22);
}

.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 48rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  pointer-events: none;
}
