.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #03040a;
  overflow: hidden;
}

.fw {
  width: 100%;
  height: 100%;
}

.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 48rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  pointer-events: none;
}
